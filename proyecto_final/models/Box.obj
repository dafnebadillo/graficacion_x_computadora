# The sphere Cornell Box as seen in Henrik Jensen's 
# "Realistic Image Synthesis Using Photon Mapping" (Page 107 Fig. 9.10) in OBJ format.
# Note that the real box is not a perfect cube, so
# the faces are imperfect in this data set.
#
# Created by Guedis Cardenas and Morgan McGuire at Williams College, 2011
# Released into the Public Domain.
#
# http://graphics.cs.williams.edu/data
# http://www.graphics.cornell.edu/online/box/data.html
# http://www.cs.cmu.edu/~djames/15-864/pics/cornellBox.jpg
#

## Object floor
v   1.0000 0.0000 -1.0400
v  -0.9900 0.0000 -1.0400
v  -1.0100 0.0000  0.9900
v   1.0000 0.0000  0.9900
# 4 vertices

vn 0.0000 1.0000 -0.0000
# 1 vertex normals

g floor

s 1
f 1//1 2//1 3//1 
f 3//1 4//1 1//1 
# 2 faces

## Object ceiling 
v   1.0000 1.5900 -1.0400
v   1.0000 1.5900  0.9900
v  -1.0200 1.5900  0.9900
v  -1.0200 1.5900 -1.0400
# 4 vertices

vn 0.0000 -1.0000 -0.0000
# 1 vertex normals

g ceiling

s 1
f 5//2 6//2 7//2 
f 7//2 8//2 5//2
# 2 faces

## Object backwall 
v   1.0000 1.5900 -1.0400
v  -1.0200 1.5900 -1.0400
v  -0.9900 0.0000 -1.0400
v   1.0000 0.0000 -1.0400
# 4 vertices

vn 0.0000 0.0000 1.0000
# 1 vertex normals

g backWall

s 1
f 9//3 10//3 11//3 
f 11//3 12//3 9//3 
# 2 faces

## Object rightwall 
v  1.0000 1.5900 0.9900
v  1.0000 1.5900 -1.0400
v  1.0000 0.0000 -1.0400
v  1.0000 0.0000 0.9900
# 4 vertices

vn -1.0000 0.0000 -0.0000
# 1 vertex normals

g rightWall

s 1
f 13//4 14//4 15//4 
f 15//4 16//4 13//4 
# 1105 --> 13
# 2 faces

## Object leftWall 
v  -1.0200 1.5900 -1.0400
v  -1.0200 1.5900 0.9900
v  -1.0100 0.0000 0.9900
v  -0.9900 0.0000 -1.0400
# 4 vertices

vn 0.9999 0.0135 0.0057
vn 1.0000 0.0063 -0.0000
vn 0.9999 0.0116 0.0042
vn 0.9998 0.0189 0.0098
# 4 vertex normals

g leftWall

s 1
f 17//5 18//6 19//7 
f 19//7 20//8 17//5 
# 2 faces

## Object light
v  0.2300 1.5800 -0.2200
v  0.2300 1.5800 0.1600
v  -0.2400 1.5800 0.1600
v  -0.2400 1.5800 -0.2200
# 4 vertices

vn 0.0000 -1.0000 -0.0000
# 1 vertex normals

g light

s 1
f 21//9 22//9 23//9 
f 23//9 24//9 21//9 
# 2 faces

